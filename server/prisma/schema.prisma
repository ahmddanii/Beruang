datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role                String   @default("UMKM") // UMKM, CONSULTANT, INVESTOR, ADMIN
  phone               String?
  avatar              String?
  verified            Boolean  @default(true)
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  businessProfile   BusinessProfile?
  consultantProfile ConsultantProfile?
  investorProfile   InvestorProfile?
  accessRequests    AccessRequest[]
  notifications     Notification[]
  watchlists        InvestorWatchlist[]
}

model ConsultantProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmName           String
  specialization     String?  @default("F&B & Ritel")
  bnspLicense        String?  @default("BNSP-KM-2026-9812")
  city               String?  @default("Bandung")
  experience         String?  @default("8 Tahun")
  maxClients         Int      @default(10)
  isCertified        Boolean  @default(true)
  activeClientsCount Int      @default(0)
  createdAt          DateTime @default(now())

  businesses  BusinessProfile[]
  assignments ConsultantAssignment[]
}

model InvestorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmName          String
  commitmentCapital String   @default("Rp 1.5 Miliar")
  investorType      String?  @default("Angel Syndicate")
  sectors           String?  @default("F&B, FMCG, Agroindustri")
  minMargin         Float?   @default(40.0)
  city              String?  @default("Jakarta")
  isVerified        Boolean  @default(true)
  createdAt         DateTime @default(now())
}

model BusinessProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand             String
  name              String
  ownerName         String?  @default("Fikri Setiawan")
  sector            String
  location          String
  city              String?  @default("Bandung")
  description       String?  @default("")
  fundingTarget     Float    @default(250000000)
  equityOffered     String   @default("12%")
  status            String   @default("ACTION_PLAN_ACTIVE") // PROFILE_INCOMPLETE, PROFILE_COMPLETE, CONSULTANT_ASSIGNED, ACTION_PLAN_ACTIVE, READY_FOR_FUNDING
  consultantId      String?
  consultant        ConsultantProfile? @relation(fields: [consultantId], references: [id], onDelete: SetNull)
  nextMentoring     String   @default("Kamis, 14:00 WIB")
  nib               String?  @default("1209000123456")
  npwp              String?  @default("81.423.891.4-429.000")
  bankName          String?  @default("Bank Mandiri")
  bankAccountNumber String?  @default("1300098765432")
  bankAccountHolder String?  @default("Kopi Senja Nusantara")
  outletsCount      Int      @default(1)
  employeesCount    Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assessment     Assessment?
  tasks          ActionPlanTask[]
  dailyTxs       DailyTransaction[]
  monthlyReports MonthlyReport[]
  documents      DataRoomDocument[]
  accessRequests AccessRequest[]
  watchlists     InvestorWatchlist[]
  assignments    ConsultantAssignment[]
  chatThreads    ChatThread[]
}

model ConsultantAssignment {
  id           String            @id @default(cuid())
  businessId   String
  business     BusinessProfile   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  consultantId String
  consultant   ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  slaDays      Int               @default(7)
  notes        String?
  assignedAt   DateTime          @default(now())
}

model Assessment {
  id              String          @id @default(cuid())
  businessId      String          @unique
  business        BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  financial       Int             @default(78)
  operationsHpp   Int             @default(85)
  marketing       Int             @default(64)
  hrTeam          Int             @default(75)
  legal           Int             @default(92)
  compositeScore  Int             @default(79)
  isVerified      Boolean         @default(true)
  consultantNotes String?
  updatedAt       DateTime        @updatedAt
}

model ActionPlanTask {
  id                 String          @id @default(cuid())
  businessId         String
  business           BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  category           String          @default("Finansial") // Finansial, Operasional, Pemasaran, Legalitas, Tata Kelola
  priority           String          @default("Sedang") // Mendesak, Tinggi, Sedang
  dueDate            String
  status             String          @default("TODO") // TODO, IN_PROGRESS, DONE
  completed          Boolean         @default(false)
  umkmNotes          String?
  evidenceName       String?
  evidenceUrl        String?
  evidenceSize       String?
  consultantFeedback String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model DailyTransaction {
  id            String          @id @default(cuid())
  businessId    String
  business      BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date          String
  title         String
  category      String          @default("PEMASUKAN") // PEMASUKAN, MODAL_JUALAN, OPERASIONAL
  amount        Float
  paymentMethod String          @default("QRIS") // QRIS, TRANSFER, TUNAI
  status        String          @default("VERIFIED") // VERIFIED, PENDING
  receiptNumber String?
  receiptUrl    String?
  notes         String?
  createdAt     DateTime        @default(now())
}

model MonthlyReport {
  id                String          @id @default(cuid())
  businessId        String
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  month             String
  year              Int
  monthYear         String
  omzet             Float
  hpp               Float
  hppRatio          Int
  opex              Float
  loss              Float?          @default(0)
  netProfit         Float
  cashBalance       Float
  status            String          @default("VERIFIED") // submitted, verified, revision_needed
  proofDocumentName String?
  proofDocumentSize String?
  proofDocumentUrl  String?
  notes             String?
  anomalyFlagged    Boolean         @default(false)
  submittedAt       DateTime        @default(now())
}

model DataRoomDocument {
  id             String          @id @default(cuid())
  businessId     String
  business       BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  category       String          @default("Legalitas") // Legalitas, Keuangan, Operasional, Perizinan
  size           String          @default("1.5 MB")
  fileUrl        String?
  storagePath    String?
  isConfidential Boolean         @default(true)
  verifiedAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())
}

model AccessRequest {
  id               String          @id @default(cuid())
  businessId       String
  business         BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  investorId       String
  investor         User            @relation(fields: [investorId], references: [id], onDelete: Cascade)
  proposedTicket   Float           @default(250000000)
  investmentScheme String          @default("REVENUE_SHARE")
  introMessage     String?
  status           String          @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedAt      DateTime        @default(now())
  respondedAt      DateTime?
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  category    String   @default("KAS") // KONSULTAN, INVESTOR, KESEHATAN, KAS, AKSI
  priority    String   @default("NORMAL") // HIGH, NORMAL
  isRead      Boolean  @default(false)
  link        String   @default("/dashboard/progres")
  actionLabel String?  @default("Lihat Kas")
  createdAt   DateTime @default(now())
}

model InvestorWatchlist {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([userId, businessId])
}

model ChatThread {
  id              String           @id @default(cuid())
  businessId      String?
  business        BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  umkmId          String?
  investorId      String?
  investorName    String?          @default("Hendro Wicaksono")
  investorLembaga String?          @default("Nusantara Impact Angel Syndicate")
  investorAvatar  String?          @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop&crop=faces")
  dealStatus      String           @default("Tahap Penjajakan Awal")
  ticketDiscussed Float            @default(150000000)
  unreadInvestor  Int              @default(0)
  unreadUmkm      Int              @default(0)
  lastMessage     String           @default("")
  lastMessageAt   String?          @default("Baru saja")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  messages        ChatMessage[]
}

model ChatMessage {
  id                 String      @id @default(cuid())
  threadId           String
  thread             ChatThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderRole         String      // "INVESTOR" | "UMKM"
  senderName         String
  text               String
  timestamp          String
  attachmentType     String?     // "METRIC" | "DOCUMENT" | "DEAL_OFFER"
  attachmentTitle    String?
  attachmentSubtitle String?
  attachmentValue    String?
  createdAt          DateTime    @default(now())
}

