# Port Server Backend
PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL / Local PostgreSQL / MySQL)
# 1. Untuk Supabase (Transaction Pooler - Port 6543):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# 2. Untuk Supabase Direct Connection (Session / Migrations - Port 5432):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# JWT Authentication Secret
JWT_SECRET="beruang-super-secret-key-2026-b2b-umkm"
JWT_EXPIRES_IN="7d"

# Supabase Storage (Free Tier - Object Storage)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Gemini API (Free Tier - AI Copilot & Anomaly Alert)
# Dapatkan gratis dari: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# Frontend Origin CORS
FRONTEND_URL="http://localhost:3000"
