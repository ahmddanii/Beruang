# ==============================================================================
# FILE INI UNTUK APA:
# File ini adalah template konfigurasi environment variables (Vite SPA) untuk platform Beruang.
# Salin file ini menjadi `.env` atau `.env.local` sebelum menjalankan server pengembangan lokal.
# DILARANG menaruh API Key atau Secret produksi asli di file ini.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. [WAJIB] Backend API Configuration
# ------------------------------------------------------------------------------
# URL dasar untuk REST API server backend Beruang (Express.js / Vercel Backend)
NUXT_PUBLIC_API_BASE_URL=https://beruang-api.vercel.app/api

# Google OAuth 2.0 Client ID (Dari Google Cloud Console)
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# Legacy Vite config (jika menggunakan standalone tools)
VITE_API_BASE_URL=https://beruang-api.vercel.app/api

# ------------------------------------------------------------------------------
# 2. [WAJIB] Application Environment Mode
# ------------------------------------------------------------------------------
# Mode lingkungan aplikasi: 'development', 'staging', atau 'production'
VITE_APP_ENV=[APP_ENV_MODE]
# Contoh: VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 3. [OPSIONAL] AI Copilot & Anomaly Service
# ------------------------------------------------------------------------------
# Endpoint server AI / LLM gateway untuk asisten konsultasi cerdas dan deteksi anomali
VITE_AI_SERVICE_URL=[AI_SERVICE_URL_VALUE]
# Contoh: VITE_AI_SERVICE_URL=https://ai.beruang.id/v1

# ------------------------------------------------------------------------------
# 4. [OPSIONAL] Feature Flags
# ------------------------------------------------------------------------------
# Mengaktifkan mode mock data jika server backend sedang offline
VITE_ENABLE_MOCK_DATA=true

# Mengaktifkan tombol debug switch role di header
VITE_ENABLE_ROLE_SWITCHER=true

# ==============================================================================
# ## Cara Mengisi
#
# 1. Buat salinan file ini di direktori root dengan perintah:
#    cp .env.example .env
#
# 2. Apa saja nilai yang harus diisi:
#    - `VITE_API_BASE_URL`: Minta URL server backend kepada tim backend atau gunakan `http://localhost:3000/api` jika menjalankan server lokal.
#    - `VITE_APP_ENV`: Isi dengan `development` untuk komputer lokal, atau `production` di server hosting.
#    - `VITE_AI_SERVICE_URL`: URL microservice Claude/AI jika fitur analisis AI diaktifkan.
#
# 3. Contoh konkret pengisian file .env:
#    VITE_API_BASE_URL=http://localhost:3000/api
#    VITE_APP_ENV=development
#    VITE_AI_SERVICE_URL=http://localhost:3000/ai
#    VITE_ENABLE_MOCK_DATA=true
#    VITE_ENABLE_ROLE_SWITCHER=true
# ==============================================================================
